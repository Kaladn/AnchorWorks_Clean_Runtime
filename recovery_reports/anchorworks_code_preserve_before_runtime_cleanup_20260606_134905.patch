+std::string json_skipped_files(const std::vector<std::pair<std::filesystem::path, std::string>>& skipped) {
+    std::string out = "[";
+    bool first = true;
+    for (const auto& [path, reason] : skipped) {
+        if (!first) {
+            out += ",";
+        }
+        first = false;
+        out += "{\"source_path\":\"" + json_escape(path.string()) + "\",\"reason\":\"" + json_escape(reason) + "\"}";
+    }
+    out += "]";
+    return out;
+}
